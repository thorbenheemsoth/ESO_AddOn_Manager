# Maintainer: thorben
pkgname=wolfs-addon-manager
pkgver=1.0.0
pkgrel=1
pkgdesc="Desktop GUI for browsing, installing, updating, and removing Elder Scrolls Online add-ons"
arch=("x86_64")
url="https://github.com/gspanetta/ESO_AddOn_Manager"
license=("MIT")
provides=("eso-addon-manager-linux")
conflicts=("eso-addon-manager-linux")
replaces=("eso-addon-manager-linux")
depends=(
  "gtk3"
  "hicolor-icon-theme"
  "openssl"
  "webkit2gtk-4.1"
  "xdg-utils"
)
makedepends=(
  "cargo"
  "nodejs"
  "pnpm"
  "rust"
)
source=()
sha256sums=()
options=("!lto")

build() {
  cd "${startdir}/../.."
  pnpm install --frozen-lockfile
  pnpm tauri build --no-bundle
}

package() {
  cd "${startdir}/../.."

  install -Dm755 "src-tauri/target/release/wolfs-addon-manager" \
    "${pkgdir}/usr/bin/wolfs-addon-manager"

  install -Dm644 "packaging/arch/wolfs-addon-manager.desktop" \
    "${pkgdir}/usr/share/applications/wolfs-addon-manager.desktop"

  install -Dm644 "src-tauri/icons/128x128.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/wolfs-addon-manager.png"

  install -Dm644 "src-tauri/icons/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/wolfs-addon-manager.png"

  install -Dm644 "README.md" \
    "${pkgdir}/usr/share/doc/wolfs-addon-manager/README.md"

  install -Dm644 "LICENSE" \
    "${pkgdir}/usr/share/licenses/wolfs-addon-manager/LICENSE"
}
